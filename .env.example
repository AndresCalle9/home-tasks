# Copy to .env (never commit .env with real values).
# The client never talks to Supabase directly in this app (all access goes
# through the Next.js API layer / Server Actions), so none of these need a
# NEXT_PUBLIC_ prefix — including the Auth-related ones below, which are
# only ever used inside Server Actions and middleware.ts, never in a
# "use client" file.

# Supabase project base URL, e.g. https://xxxx.supabase.co (no /rest/v1 suffix
# — the Supabase client appends that itself).
SUPABASE_URL=

# Supabase anon/publishable key. SERVER-SIDE ONLY. Used to run Supabase Auth
# (sign up/in/out, session refresh) and to run every household-scoped data
# query as the signed-in user, so Postgres Row Level Security actually
# enforces per-household isolation (RLS is bypassed entirely by the service
# role key below, so this key — not that one — is what makes multi-tenant
# isolation real). Never prefix with NEXT_PUBLIC_, never import into a
# "use client" component.
SUPABASE_ANON_KEY=

# Supabase service role key. SERVER-SIDE ONLY, and only for hand-run
# maintenance/migration scripts (it bypasses Row Level Security entirely) —
# no application code path in the request lifecycle should import it.
# Never prefix with NEXT_PUBLIC_, never import into a "use client" component,
# never log it.
SUPABASE_SERVICE_ROLE_KEY=

# This app's own public URL, used for metadataBase/sitemap/robots/JSON-LD.
# Not sensitive. Usually unnecessary on Vercel — it falls back to
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL, which Vercel sets automatically.
# Set this only to override that (e.g. a custom domain not yet reflected
# there), or for local dev pointed at a non-default port.
NEXT_PUBLIC_SITE_URL=

# URL of the Trastero hub, rendered as a plain link in HubHeader/HubFooter
# (@andrescalle9/ui). Not sensitive, so NEXT_PUBLIC_ is correct here. Set to
# the hub's Vercel URL for now; switch to https://trastero.dev once that
# domain is live. Falls back to a placeholder if unset — see lib/hub.ts.
NEXT_PUBLIC_HUB_URL=
