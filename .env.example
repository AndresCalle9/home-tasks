# Copy to .env (never commit .env with real values).

# Supabase project URL (safe to expose to the client if ever needed).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe to expose to the client).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_,
# never import into a "use client" component, never log it.
SUPABASE_SERVICE_ROLE_KEY=
