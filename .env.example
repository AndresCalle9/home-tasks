# Copy to .env (never commit .env with real values).
# The client never talks to Supabase directly in this app (all access goes
# through the Next.js API layer), so none of these need a NEXT_PUBLIC_ prefix.

# Supabase project base URL, e.g. https://xxxx.supabase.co (no /rest/v1 suffix
# — the Supabase client appends that itself).
SUPABASE_URL=

# Supabase anon/publishable key. Not currently used (no client-side Supabase
# calls), kept for reference / future use.
SUPABASE_ANON_KEY=

# Supabase service role key. SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_,
# never import into a "use client" component, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating the actions that change a period's outcome:
# running the sorteo, rerolling it, and manually reassigning a task's
# member or day from the Calendario tab. SERVER-SIDE ONLY — checked inside
# the server actions themselves, never sent to the client, never logged.
# If unset, every gated action is rejected (fails closed).
SECURITY_PASSWORD=
